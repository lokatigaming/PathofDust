# Copy this file to .env and fill in your values.
# Get CLIENT_ID and CLIENT_SECRET from https://dev.twitch.tv/console/apps
# When creating the app, set OAuth Redirect URL to: http://localhost:3000/callback
# Category: Chat Bot

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=Lokati_Gaming

# Absolute path to the lokati.net site folder (Cloudflare-deployed), used to
# write commands-data.json for the public commands page. Leave unset to skip
# regenerating that file (the bot still runs fine locally without it).
# Quoted because the path contains a space — an unquoted value with a space
# breaks parsing (dotenvy aborts loading the *rest* of the file too, unlike
# Node's dotenv which tolerates it), so always quote any .env value with a
# space in it.
PUBLIC_SITE_DIR='C:\Users\Administrator\Downloads\SIK Claude'

# Optional: Patreon new-patron alerts.
# Get these from https://www.patreon.com/portal/registration/register-clients
# Redirect URI to register: http://localhost:3001/callback
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
# How often to poll Patreon for new patrons, in milliseconds (default 60000 = 60s)
PATREON_POLL_INTERVAL_MS=60000

# Optional: periodic chat announcement. Fires at most every
# ANNOUNCEMENT_INTERVAL_MS, only if at least ANNOUNCEMENT_MIN_MESSAGES chat
# messages came in since it last fired. Message text lives in
# announcements.json (cycles through the list in order); an empty list
# disables the feature.
ANNOUNCEMENT_INTERVAL_MS=1200000
ANNOUNCEMENT_MIN_MESSAGES=10

# Local port for the self-hosted OBS alert-box overlay (public/alert-box.html).
# Point an OBS Browser Source at http://localhost:<this port>/alert-box.html
ALERT_SERVER_PORT=4001

# Optional: StreamElements tip/donation alerts (tips go through PayPal via
# StreamElements, so they're a separate connection from Twitch EventSub).
# Get this from the StreamElements dashboard -> Account -> Channels ->
# "Show secrets" -> JWT Token.
STREAMELEMENTS_JWT=

# Optional: PayPal tip alerts (paypal.me links, e.g. puppies.html's Pup'
# Kitchen menu). PayPal can't reach this bot directly (no public address),
# so a Cloudflare Worker relay receives PayPal's webhook and this just
# polls it — see cloudflare-paypal-relay/worker.js for the Worker itself
# and its setup notes. Both values below must be set to enable this; the
# token must match the RELAY_TOKEN secret set on the Worker.
PAYPAL_RELAY_URL=
PAYPAL_RELAY_TOKEN=
PAYPAL_POLL_INTERVAL_MS=15000

# Optional: built-in song requests (replaces StreamElements' song request
# feature). Get a free API key at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3"). Leave unset to disable song requests
# entirely — the !songrequest/!sr/!queue/!nowplaying/!skip/!voteskip/
# !clearqueue commands will just reply that it's disabled.
#
# A single free-tier key is capped at 100 search.list calls/day (text
# searches only — direct YouTube links use a separate, much cheaper
# quota). Resolved searches are also cached locally, so repeat requests
# for a song already looked up don't cost quota again. If that's still
# not enough, create additional Google Cloud projects/keys and list them
# all in YOUTUBE_API_KEYS (comma-separated) instead of the single-key
# variable below — the bot rotates to the next key once one hits its
# daily quota.
YOUTUBE_API_KEY=
# YOUTUBE_API_KEYS=key1,key2,key3
# Local port for the OBS browser source that plays the queued videos, and
# the /dock control panel (add as an OBS Custom Browser Dock).
# Point an OBS Browser Source at http://localhost:<this port>/
SONG_REQUEST_SERVER_PORT=4002
# Songs longer than this (in seconds) are rejected at request time.
SONG_REQUEST_MAX_DURATION_SECONDS=600
# Unique chatters needed for !voteskip/!vs to skip the current song.
SONG_REQUEST_VOTESKIP_THRESHOLD=3
# Unique chatters needed for !votepause to pause the current song, and
# separately for !votestart to resume it.
SONG_REQUEST_VOTEPAUSE_THRESHOLD=3
SONG_REQUEST_VOTERESUME_THRESHOLD=3
# Once !votepause pauses the song, !votestart can't actually resume it
# until this many seconds have passed, even if its vote already hit
# threshold — the resume just waits out the rest of the cooldown.
SONG_REQUEST_RESUME_COOLDOWN_SECONDS=30
# Unique chatters needed for !votevolume to set a particular volume level.
# The requested percent is always clamped to 50-75 regardless of this.
SONG_REQUEST_VOTEVOLUME_THRESHOLD=3

# Local port for the transparent, draggable Twitch chat overlay (with
# Twitch/BTTV/FFZ emotes). Point an OBS Browser Source at
# http://localhost:<this port>/ — background is transparent by default, no
# OBS chroma key needed. Always enabled (no separate on/off switch).
CHAT_OVERLAY_SERVER_PORT=4003

# League for !essenceprofit's live poe.ninja lookups. Update this when a
# new league launches — no redeploy needed, just edit and restart.
POE_NINJA_LEAGUE=Allflame

# Optional: pushes !playlist data (everyone's saved personal song
# playlists) to the same Apps Script backend the build feed runs through,
# so lokati.net/playlists.html and playlist.html have something to poll —
# local files in PUBLIC_SITE_DIR never actually reach the live site. Must
# match the PLAYLIST_SYNC_SECRET script property on that Apps Script
# project (Project Settings -> Script Properties). Leave unset to disable
# the sync — !playlist and its own local data keep working regardless,
# only the public site falls behind.
PLAYLIST_SYNC_SECRET=

# Cost (in channel points) of the self-service "Set Entrance Theme Song"
# reward — viewers redeem it, typing a YouTube link/search as the reward's
# text input, to set their own entrance theme with no mod needed. Only
# takes effect the first time the reward is created (see channel_points.rs);
# requires re-running `cargo run --bin auth` if tokens.json predates the
# channel:manage:redemptions scope.
CHANNEL_POINTS_THEME_REWARD_COST=5000

# Optional: powers !playrandom's genre matching (queues/continuously plays
# songs "similar" to the last 10 actually played, via Last.fm genre tags —
# YouTube itself has no genre metadata). Free key, no approval needed:
# https://www.last.fm/api/account/create (any app name/description works).
# Leave unset to disable !playrandom — it'll reply that it's not enabled.
LASTFM_API_KEY=

# Optional: lets !votevolume/!modvolume control OBS's own per-source
# volume fader directly, instead of the YouTube player's internal volume.
# This matters if you've added Compressor/Limiter filters to the song
# overlay source for loudness leveling — those apply a fixed makeup gain
# that otherwise cancels out changes to the player's internal volume,
# since OBS's fader applies *after* filters and isn't affected by them.
# Enable OBS's WebSocket server first: Tools -> WebSocket Server Settings
# -> Enable WebSocket server (grab the password shown there too, if auth
# is on, which it is by default).
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
# Exact name of the song overlay's Browser Source, as it appears in OBS's
# Sources list — required for this to work at all. Leave both this and
# the password unset to disable OBS volume control entirely (the vote/mod
# volume commands then just reply that it's not configured).
OBS_SONG_SOURCE_NAME=
