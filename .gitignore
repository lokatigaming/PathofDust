# --- Secrets / credentials ---
.env
tokens.json
patreon-tokens.json

# --- Rust build artifacts ---
/target
# Separate build output dir used for the Stage 5 bake prep (building the
# new binaries while the currently-running one still holds a file lock
# on /target/release) - see REFACTOR_PLAN.md's bake deployment proposal.
/target-bake
# Separate build output dir for feature/elementalist's own verification
# builds - production's target/release binaries are live-running
# processes and must never be touched by this branch's work.
/target-elementalist
# Pre-cutover rollback backups (real player data + a binary) - never tracked.
/backup-pre-bake
# Pre-Elementalist-deploy rollback backup (both binaries + data files),
# same "backup before overwrite" discipline as backup-pre-bake above.
/backup-pre-elementalist
# Pre-fight-announcement-batching-deploy rollback backup, same discipline.
/backup-pre-fight-batching
# Pre-golem-bugfixes-deploy rollback backup, same discipline.
/backup-pre-golem-bugfixes
# Pre-per-level-scaling-fix-deploy rollback backup, same discipline.
/backup-pre-perlevel-fix
# Pre-golem-attribution-deploy rollback backup, same discipline.
/backup-pre-golem-attribution
# Pre-consolidated-fix-deploy rollback backup, same discipline.
/backup-pre-consolidated-fix
# Pre-thunder-redistribution-deploy rollback backup, same discipline.
/backup-pre-thunder-redistribution
# Pre-craft-diagnostic-deploy rollback backup, same discipline.
/backup-pre-craft-diag
# Pre-Release-1.1-deploy rollback backup, same discipline.
/backup-pre-release-1.1
# Pre-Memories-deploy rollback backup, same discipline.
/backup-pre-memories
# Pre-Release-2-deploy rollback backup, same discipline.
/backup-pre-release-2
# Pre-live-tunables-deploy rollback backup, same discipline.
/backup-pre-live-tunables
# Pre-chat-noise-cleanup-deploy rollback backup, same discipline.
/backup-pre-chat-noise-cleanup
# Pre-Release-1.2-deploy rollback backup, same discipline.
/backup-pre-release-1.2
# Pre-Divine-Dust-deploy rollback backup, same discipline.
/backup-pre-divine-dust
# Pre-Divine-Dust-craft-fix-deploy rollback backup, same discipline.
/backup-pre-divine-dust-craft-fix
# Pre-Elementalist-rework-deploy rollback backup (RF self-damage mitigation
# + golem synergy), same discipline.
/backup-pre-rf-self-damage-mitigation
# Pre-corrective-Elementalist-release rollback backup (golem penalty
# removed, RF re-homed, full inheritance, live golem speed), same
# discipline.
/backup-pre-elementalist-corrective
# Pre-elemental-damage-all-slots-deploy rollback backup, same discipline.
/backup-pre-elemental-slots
# Pre-unified-unique-shards-deploy rollback backup (binaries + the
# standard pre-migration character-data backup), same discipline.
/backup-pre-unified-unique-shards
# Pre-golem-inheritance-deploy rollback backup (binaries + the first
# pinned pre-deploy fight-summary snapshot, per §13's new step), same
# discipline.
/backup-pre-golem-inheritance
# Pre-shattering-toggle-deploy rollback backup, same discipline.
/backup-pre-shattering-toggle
# Pre-vitals-fix-deploy rollback backup (release A - thunder_golem_redirect
# ownership scoping), same discipline.
/backup-pre-vitals-fix
# Pre-shattering-fix-deploy rollback backup (release B - damage-
# multiplier + Doom leak fixes, re-enable), same discipline.
/backup-pre-shattering-fix
# Pre-thunder-golem-party-wide-deploy rollback backup (Thunder Golem
# revert to party-wide + Shattering tunable restructure), same
# discipline.
/backup-pre-thunder-golem-party-wide
# Pre-overlay-compression-deploy rollback backup (Phase 1 - opt-in WS
# compression + feed=parent), same discipline.
/backup-pre-overlay-compression
# Pre-dr-cap-38-deploy rollback backup (damage reduction hard-cap
# doctrine, universal, no exemptions), same discipline.
/backup-pre-dr-cap-38
# Pre-bridge-fix-deploy rollback backup (emergency - desktop envelope
# mismatch + zlib compression format), same discipline.
/backup-pre-bridge-fix

