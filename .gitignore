# --- Secrets / credentials ---
.env
tokens.json
patreon-tokens.json

# --- Rust build artifacts ---
/target
# Separate build output dir used for the Stage 5 bake prep (building the
# new binaries while the currently-running one still holds a file lock
# on /target/release) - see REFACTOR_PLAN.md's bake deployment proposal.
/target-bake
# Separate build output dir for feature/elementalist's own verification
# builds - production's target/release binaries are live-running
# processes and must never be touched by this branch's work.
/target-elementalist
# Pre-cutover rollback backups (real player data + a binary) - never tracked.
/backup-pre-bake
# Pre-Elementalist-deploy rollback backup (both binaries + data files),
# same "backup before overwrite" discipline as backup-pre-bake above.
/backup-pre-elementalist
# Pre-fight-announcement-batching-deploy rollback backup, same discipline.
/backup-pre-fight-batching
