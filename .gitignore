# --- Local agent-tooling copies (never committed) ---
# .clinerules is a local copy of CLAUDE.md for the Cline agent.
.clinerules

# Pre-fail-loud-deploy rollback backup (refuse-to-start guard for corrupt
# save files; both binaries + pinned adventure-fights-summary snapshot),
# same "backup before overwrite" discipline as every backup-pre-* above.
/backup-pre-fail-loud
/backup-pre-build-seam
/backup-pre-dynamic-pacing
backup-pre-pacing-controller-loop/
# Pre-passive-tunables-stage0+1-deploy rollback backup (game.exe + pinned
# fight-summary snapshot), same "backup before overwrite" discipline as
# every backup-pre-* above.
/backup-pre-passive-tunables-stage1
# Pre-divinity-and-item-locks-deploy rollback backup (game.exe +
# twitch-bot-rs.exe + pinned fight-summary snapshot), same "backup
# before overwrite" discipline as every backup-pre-* above.
/backup-pre-divinity
*-watchdog-maintenance.flag

# Crash-window temp files from state.rs's atomic save path (write beside
# the target, fsync, rename over). Removed on both success and failure, so
# one only ever survives a hard kill mid-write.
*.tmp

# Pre-passive-tunables-stage2-deploy rollback backup (game.exe + pinned
# fight-summary snapshot), same "backup before overwrite" discipline as
# every backup-pre-* above.
/backup-pre-passive-tunables-stage2

# Stage 3 passive-tunables feature session's own --target-dir (house rule:
# one per feature worktree, production binaries are file-locked).
target-stage3/

# Rollback copy of the pre-Stage-3 game.exe (plus that deploy's pinned
# fight-summary snapshot), same "backup before overwrite" discipline as
# every backup-pre-* above.
/backup-pre-passive-tunables-stage3
/backup-pre-identity-units

# Rollback copy of the pre-World-2-Stage-2 game.exe (announcement feed +
# operator levers), plus that deploy's pinned fight-summary snapshot.
/backup-pre-world2-stage2

# Rollback copy of the pre-World-2-Stage-3a game.exe (operator identity),
# plus that deploy's pinned fight-summary snapshot.
/backup-pre-operator-identity
target-remove-patreon/

# Rollback copies of the pre-Patreon-removal game.exe and
# twitch-bot-rs.exe, that deploy's pinned fight-summary snapshot, and
# the two retired Patreon data files moved out of the deployment root.
/backup-pre-remove-patreon
target-deploy-remove-patreon/
/backup-pre-bot-standalone
/backup-pre-linux-readiness
target-deploy-bot-standalone/
